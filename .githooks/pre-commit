#!/bin/sh
# Linter (siehe eslint.config.js) vor jedem Commit: nur wenn die Werkzeuge installiert sind
# (npm install im Projektstamm); die CI prüft ohnehin bei jedem Push.
# Aktiv über "git config core.hooksPath .githooks" (einmal pro Klon).
# Cache-Busting braucht hier nichts mehr: Vite gibt den gebauten Dateien einen Hash im Namen.
set -e
if [ -x node_modules/.bin/eslint ]; then
  node_modules/.bin/eslint . || { echo "pre-commit: Linter meldet Fehler (npm run lint)." >&2; exit 1; }
fi
exit 0
